{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "after 9am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "packageRules": [
    {
      "description": "Automerge non-major updates for GitHub Actions after stabilization",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group all Helm chart dependency updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/**"
      ],
      "groupName": "helm-chart-dependencies",
      "minimumReleaseAge": "7 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml (Docker image tag with 'v' prefix)",
      "managerFilePatterns": [
        "/charts/.*/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\nappVersion:\\s*[\"']?(?<currentValue>.*?)[\"']?\\s*$"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update image tag in values.yaml",
      "managerFilePatterns": [
        "/charts/.*/values\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\n\\s*tag:\\s*[\"']?(?<currentValue>.*?)[\"']?\\s*$"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update busybox image in deployment templates",
      "managerFilePatterns": [
        "/charts/.*/templates/deployment\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>busybox):(?<currentValue>\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "bumpVersions": [
    {
      "filePatterns": [
        "/^({{#each (distinct (lookupArray upgrades \"packageFileDir\"))}}{{{.}}}{{#unless @last}}|{{/unless}}{{/each}})/Chart\\.(yaml|yml)$/"
      ],
      "matchStrings": [
        "version:\\s(?<version>[^\\s]+)"
      ],
      "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
    }
  ]
}
