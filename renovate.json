{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "after 9am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 20,
  "packageRules": [
    {
      "description": "Group CI dependencies (actions, Helm CLI, lint images) as ci(deps)",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "github-actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Automerge non-major CI dependency updates after stabilization",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Keep the Helm CLI on 3.x until Helm 4 is validated with chart-testing",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "helm",
        "helm/helm"
      ],
      "allowedVersions": "<4"
    },
    {
      "description": "Group all Helm chart dependency updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/**"
      ],
      "groupName": "helm-chart-dependencies",
      "semanticCommitType": "fix"
    },
    {
      "description": "Mark upstream major updates as breaking so the PR title matches the chart major bump",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "commitMessagePrefix": "feat(deps)!:",
      "commitMessageAction": "update"
    },
    {
      "description": "GHCR exposes no release timestamps; without this minimumReleaseAge holds its updates forever (they skip the age gate)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/**"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^charts/.+\\.ya?ml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "[\\t ]*(?:#|//) ?renovate: (?<datasource>git-refs)=(?<depName>\\S+)(?: branch=(?<currentValue>\\S+))?[\\t ]*\\r?\\n.+?[:=][\\t ]*[\"']?(?<currentDigest>[a-f0-9]+)[\"']?",
        "[\\t ]*(?:#|//) ?renovate: (?<datasource>[^=]+)=(?<depName>\\S+)(?: registry=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?[\\t ]*\\r?\\n.+?[:=][\\t ]*[\"']?(?<currentValue>[^@\\s\"'=]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else if (equals datasource 'git-refs')}}master{{/if}}",
      "datasourceTemplate": "{{#if (equals datasource 'github')}}github-tags{{else}}{{{datasource}}}{{/if}}",
      "versioningTemplate": "{{#if (equals datasource 'docker')}}docker{{else if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "bumpVersions": [
    {
      "filePatterns": [
        "/^({{#each (distinct (lookupArray upgrades \"packageFileDir\"))}}{{{.}}}{{#unless @last}}|{{/unless}}{{/each}})/Chart\\.(yaml|yml)$/"
      ],
      "matchStrings": [
        "version:\\s(?<version>[^\\s]+)"
      ],
      "bumpType": "{{#if isMajor}}major{{else if isPatch}}patch{{else}}minor{{/if}}"
    }
  ]
}
